# ============================================================
# AuditPro — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to GitHub.
# ============================================================

# ── JWT Secret (required in production) ─────────────────────
# Must be at least 32 characters long
AUDIT_JWT_SECRET=your-very-long-secret-key-here-minimum-32-chars

# JWT token expiry in milliseconds (86400000 = 24 hours)
AUDIT_JWT_EXPIRY=86400000

# ── Database (leave blank to use H2 in-memory for demo) ─────

# For H2 (default demo — no setup needed):
# AUDIT_DB_URL=jdbc:h2:mem:auditdb;DB_CLOSE_DELAY=-1
# AUDIT_DB_USER=sa
# AUDIT_DB_PASSWORD=
# AUDIT_DB_DRIVER=org.h2.Driver
# AUDIT_JPA_DIALECT=org.hibernate.dialect.H2Dialect

# For MySQL (production):
# AUDIT_DB_URL=jdbc:mysql://localhost:3306/auditdb?useSSL=false&serverTimezone=UTC
# AUDIT_DB_USER=your_mysql_username
# AUDIT_DB_PASSWORD=your_mysql_password
# AUDIT_DB_DRIVER=com.mysql.cj.jdbc.Driver
# AUDIT_JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# ── Server Port ──────────────────────────────────────────────
PORT=8080
